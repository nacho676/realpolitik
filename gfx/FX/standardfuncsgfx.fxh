[[
	float ToGamma(float aLinear)
	{
		return pow(aLinear, 0.45);
	}

	float3 ToGamma(float3 aLinear)
	{
		return pow(aLinear, vec3(0.45));
	}

	float3 ToLinear(float3 aGamma)
	{
		return pow(aGamma, vec3(2.2));
	}

	float4 ToLinear(float4 aGamma)
	{
		return float4(pow(aGamma.rgb, vec3(2.2)), aGamma.a);
	}

	// Standard functions
	float3 RotateVectorByVector( float3 v1, float3 v2 )
	{
		float3 zaxis = v1; //normal
		float3 xaxis = cross( zaxis, float3( 0, 0, 1 ) ); //tangent
		xaxis = normalize( xaxis );
		float3 yaxis = cross( xaxis, zaxis ); //bitangent
		yaxis = normalize( yaxis );
		return xaxis * v2.x + zaxis * v2.y + yaxis * v2.z;
	}

	float2 RotateVector2D( float2 v, float vAngle )
	{
		float oldX = v.x;
		float vCos = cos( vAngle );
		float vSin = sin( vAngle );
		v.x = ( v.x * vCos ) - ( v.y * vSin );
		v.y = ( v.y * vCos ) + ( oldX * vSin );
		return v;
	}

	// Realpolitik: globe. Past MDR_GLOBE_CAM_START the map bends around a sphere; only the on-screen position changes,
	// textures and light keep the flat position. Generated by herramientas/globo_latitudes.py: map row to latitude (radians).
	float MdrGlobeLatitude( float z )
	{
		float v = z / MAP_SIZE_Y;
		float vLat = -1.57080f;
		vLat += 0.75960f * saturate( ( v - 0.00000f ) / 0.03125f );
		vLat += 0.28224f * saturate( ( v - 0.03125f ) / 0.11111f );
		vLat += 0.35052f * saturate( ( v - 0.14236f ) / 0.11111f );
		vLat += 0.29992f * saturate( ( v - 0.25347f ) / 0.11111f );
		vLat += 0.27639f * saturate( ( v - 0.36458f ) / 0.11111f );
		vLat += 0.25764f * saturate( ( v - 0.47569f ) / 0.11111f );
		vLat += 0.21513f * saturate( ( v - 0.58681f ) / 0.11111f );
		vLat += 0.20082f * saturate( ( v - 0.69792f ) / 0.11111f );
		vLat += 0.11833f * saturate( ( v - 0.80903f ) / 0.11111f );
		vLat += 0.38101f * saturate( ( v - 0.92014f ) / 0.07986f );
		return vLat;
	}

