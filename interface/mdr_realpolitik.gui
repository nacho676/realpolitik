guiTypes = {
	# Prices of Realpolitik's resources (uranium, grain, rare earths), continuing Millennium Dawn's row of 8 prices
	# (MD_tradeview_market_prices, 84 px each, widened to 929 px in interface/MD_countryeconomyview.gui).
	containerWindowType = {
		name = "mdr_tradeview_market_prices"
		position = { x = 676 y = 455 }
		size = { width = 252 height = 50 }
		margin = { left = -3 top = 10 }

		containerWindowType = {
			name = "mdr_price_uranium"
			position = { x = 0 y = 0 }
			size = { width = 84 height = 50 }
